# Copy to .env and fill in as needed. Every value is optional. The app runs
# with all of them empty. Keep real values out of version control.

# Set to true to seed a demo walker on an empty database (staging only).
SEED_DEMO=false

# Error tracking (Sentry/GlitchTip compatible). Leave empty to disable.
SENTRY_DSN=

# Umami analytics script URL. Leave empty to disable.
UMAMI_URL=

# Umami website id that pairs with UMAMI_URL. Leave empty to disable.
UMAMI_WEBSITE_ID=
